{
  "schemaVersion": 1,
  "id": "calendar",
  "order": 40,
  "card": {
    "name": {
      "zh": "本机日历",
      "en": "Local calendar"
    },
    "category": "local",
    "platforms": ["darwin", "win32"],
    "unsupportedReason": "eds_driver_unavailable",
    "description": {
      "zh": "读取和创建日程",
      "en": "Read and create calendar events"
    },
    "modes": [
      {
        "id": "system",
        "auth": "system",
        "capability": {
          "zh": "连接本机日历（macOS 日历或 Windows 经典版 Outlook）；修改日程前会请你确认。",
          "en": "Connects to your local calendar (macOS Calendar or Windows classic Outlook); asks before making changes."
        },
        "help": {
          "zh": "连接时会请求访问本机日历的权限。Windows 上仅支持经典版 Outlook（暂不支持新版 Outlook）；Linux 暂不支持本机日历。",
          "en": "Connecting requests access to your local calendar. On Windows, classic Outlook is required (new Outlook isn't supported yet); local calendar isn't available on Linux yet."
        },
        "documentationUrl": "https://developer.apple.com/documentation/eventkit"
      }
    ]
  },
  "mcp": {
    "presets": {
      "system": {
        "id": "calendar",
        "transport": "stdio",
        "fixedService": "calendar",
        "env": {},
        "auth": {
          "kind": "system"
        },
        "networkDomains": []
      }
    },
    "readOnlyTools": ["list_calendars", "list_events"],
    "disabledTools": ["delete_event"],
    "disabledToolPatterns": [
      "(?:^|[_-])(?:delete|remove|merge|archive|transfer|force|revoke)(?:[_-]|$)"
    ],
    "capability": {
      "id": "calendar",
      "tools": {
        "list_calendars": "calendar_list_calendars",
        "list_events": "calendar_list_events",
        "create_event": "calendar_create_event",
        "update_event": "calendar_update_event",
        "delete_event": "calendar_delete_event"
      },
      "readOnlyTools": ["list_calendars", "list_events"]
    },
    "draftBindings": [],
    "trusted": {
      "stdio": {
        "machLookup": ["com.apple.CalendarAgent", "com.apple.tccd"],
        "legacyBuiltinId": "calendar",
        "openTimeoutMs": 130000
      }
    },
    "toolDescriptions": {
      "list_calendars": {
        "zh": "列出可用日历",
        "en": "List available calendars"
      },
      "list_events": {
        "zh": "按时间范围查看日程（单次最多 31 天，支持同时查看多个日历）",
        "en": "View calendar events in a date range (up to 31 days at a time across calendars)"
      },
      "create_event": {
        "zh": "新建一条本机日程，创建前会展示详情请你确认",
        "en": "Create a new local calendar event; asks you to review details before saving"
      },
      "update_event": {
        "zh": "更新一条现有日程",
        "en": "Update one existing event"
      },
      "delete_event": {
        "zh": "删除一条日程，默认关闭",
        "en": "Delete one event; disabled by default"
      }
    }
  }
}
