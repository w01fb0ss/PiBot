{
  "schemaVersion": 1,
  "id": "contacts",
  "order": 50,
  "card": {
    "name": {
      "zh": "本机通讯录",
      "en": "Local contacts"
    },
    "category": "local",
    "platforms": ["darwin", "win32"],
    "unsupportedReason": "eds_driver_unavailable",
    "description": {
      "zh": "查找联系人",
      "en": "Find contacts"
    },
    "modes": [
      {
        "id": "system",
        "auth": "system",
        "capability": {
          "zh": "连接本机通讯录（macOS 通讯录或 Windows 经典版 Outlook）；修改联系人前会请你确认。",
          "en": "Connects to your local contacts (macOS Contacts or Windows classic Outlook); asks before making changes."
        },
        "help": {
          "zh": "连接时会请求访问本机通讯录的权限。Windows 上仅支持经典版 Outlook（暂不支持新版 Outlook）；Linux 暂不支持本机通讯录。",
          "en": "Connecting requests access to your local contacts. On Windows, classic Outlook is required (new Outlook isn't supported yet); local contacts aren't available on Linux yet."
        },
        "documentationUrl": "https://developer.apple.com/documentation/contacts"
      }
    ]
  },
  "mcp": {
    "presets": {
      "system": {
        "id": "contacts",
        "transport": "stdio",
        "fixedService": "contacts",
        "env": {},
        "auth": {
          "kind": "system"
        },
        "networkDomains": []
      }
    },
    "readOnlyTools": ["list_contacts", "search_contacts", "count_contacts"],
    "disabledTools": ["delete_contact"],
    "disabledToolPatterns": [
      "(?:^|[_-])(?:delete|remove|merge|archive|transfer|force|revoke)(?:[_-]|$)"
    ],
    "capability": {
      "id": "contacts",
      "tools": {
        "list_contacts": "contacts_list",
        "search_contacts": "contacts_search",
        "create_contact": "contacts_create",
        "update_contact": "contacts_update",
        "delete_contact": "contacts_delete",
        "count_contacts": "contacts_count"
      },
      "readOnlyTools": ["list_contacts", "search_contacts", "count_contacts"]
    },
    "draftBindings": [],
    "trusted": {
      "stdio": {
        "machLookup": [
          "com.apple.contactsd.contact-provider",
          "com.apple.contactsd.persistence",
          "com.apple.contactsd.support",
          "com.apple.AddressBook.ContactsAccountsService",
          "com.apple.contacts.account-caching",
          "com.apple.askto.client.com.apple.contacts.commlimits",
          "com.apple.AddressBook.abd",
          "com.apple.accountsd.accountmanager",
          "com.apple.cfprefsd.daemon",
          "com.apple.cfprefsd.agent",
          "com.apple.tccd"
        ],
        "legacyBuiltinId": "contacts",
        "openTimeoutMs": 130000
      }
    },
    "toolDescriptions": {
      "list_contacts": {
        "zh": "分批查看本机联系人列表",
        "en": "Browse your local contacts in pages"
      },
      "search_contacts": {
        "zh": "按姓名、电话、邮箱或公司查找本机联系人",
        "en": "Search local contacts by name, phone number, email, or company"
      },
      "create_contact": {
        "zh": "创建本机联系人",
        "en": "Create a local contact"
      },
      "update_contact": {
        "zh": "更新本机联系人",
        "en": "Update an existing local contact"
      },
      "delete_contact": {
        "zh": "删除一个联系人，默认关闭",
        "en": "Delete one contact; disabled by default"
      },
      "count_contacts": {
        "zh": "统计本机联系人总数，不读取具体联系方式",
        "en": "Count how many local contacts you have without reading personal details"
      }
    }
  }
}
