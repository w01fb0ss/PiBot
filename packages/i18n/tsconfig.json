    },
    {
      "path": "../images-contract"
    },
    {
      "path": "../models-contract"
    },
    {
      "path": "../office-contract"
    },
    {
      "path": "../plugins-contract"
    },
    {
      "path": "../remote-contract"
    },
    {
      "path": "../routines-contract"
    },
    {
      "path": "../skills-contract"
    },
    {
      "path": "../teams-contract"
    },
    {
      "path": "../videos-contract"
    },
    {
      "path": "../workspaces-contract"
    }
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "test/**"]
